                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   ESTADO DO ACRE SECRETARIA DE ESTADO DE JUSTICA E SEGURANCA PUBLICA EXTRATO DE CONTRATO N° 46/2026 O ESTADO DO ACRE, ATRAVES DA SECRETARIA DE ESTADO DE JUS- TICA E SEGURANCA PUBLICA - SEJUSP, O FUNDO ESTADUAL DE SE- GURANCA PUBLICA/FUNDESEG E A FUNDACAO GETULIO VARGAS-FGV INEXIGIBILIDADE DE LICITACAO - ART. 74, III, ´f  da Lei nº14.133/2021 PARECER PGEATTUS Nº 240/2026 PROCESSO SEI Nº 081901280500007/2026-03 OBJETO: Contratacao de instituicao de ensino superior especializada para ministrar o Curso de Extensao  Programa de Enfrentamento da Violencia con- tra a Mulher , destinado aos operadores do Sistema Integrado de Seguranca Publica - SISP do Estado do Acre, com oferta de 02 (duas) turmas por ano, com ate 40 (quarenta) alunos por turma, durante o periodo de 60 (sessenta) meses, com carga horaria anual de 120 (cento e vinte) horas, por meio da Secretaria de Estado de Justica e Seguranca Publica - SEJUSP. DO VALOR