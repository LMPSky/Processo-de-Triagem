                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 Intimação    PROCESSO: 1005581-24.2026.4.01.3000 - MANDADO DE SEGURANcA CiVEL - || PODER JUDICIARIO JUSTICA FEDERAL Secao Judiciaria do Acre 2ª Vara Federal Civel e Criminal da SJAC PROCESSO: 1005581-24.2026.4.01.3000 CLASSE: MANDADO DE SEGURANCA CIVEL (120) POLO ATIVO: CAIQUE RAMOS CANEDO REPRESENTANTES POLO ATIVO: JANDERSON SOARES DA SILVA - AC6345-A POLO PASSIVO: FUNDACAO GETULIO VARGAS e outros DECISAO CAIQUE RAMOS CANEDO impetrou mandado de seguranca em face de ato atribuido ao PRESIDENTE DO CONSELHO FEDERAL DA ORDEM DOS ADVOGADOS DO BRASIL - CFOAB e a FUNDACAO GETULIO VARGAS objetivando, liminarmente: a) que seja determinada a analise e julgamento dos seus recursos administrativos interpostos na 2ª fase do 45º Exame de Ordem Unificado da OAB, e b) a suspensao dos efeitos desfavoraveis do resultado final, impedindo que sua situacao seja tratada como encerrada administrativamente. Subsidiariamente, requer que seja determinada a reabertura do prazo recursal para nova interposicao. No merito, requer a confirmacao do pedido liminar. Tambem requer os beneficios da justica gratuita. Narra que se inscreveu no 45º Exame de Ordem Unificado da OAB e que participou da segunda fase do certame, consistente na prova pratico-profissional. Relata que obteve pontuacao considerada insuficiente para aprovacao, conforme espelho de correcao disponibilizado pela banca examinadora. Aduz que interpos recursos administrativos em face do resultado, indicando supostos erros de correcao e divergencia em relacao ao padrao de respostas divulgado pela banca. Afirma que os recursos administrativos por ele regularmente interpostos deixaram de ser apreciados em razao de falha sistemica no ambiente eletronico da banca examinadora. Ressalta que, no periodo destinado a interposicao recursal, a propria organizacao do certame reconheceu a ocorrencia de instabilidade no sistema eletronico, tendo posteriormente restituido o prazo e divulgado comunicado orientando os candidatos a realizarem nova interposicao de recursos. Entretanto, sustenta que tal orientacao nao possuia carater obrigatorio nem foi acompanhada de comando claro e inequivoco no sentido de invalidar os protocolos anteriormente gerados, razao pela qual nao poderia a Administracao desconsiderar os recursos ja regularmente interpostos. Argumenta que cumpriu integralmente o procedimento previsto no edital, tendo obtido os respectivos numeros de protocolo, os quais, por forca das regras do certame, constituem prova da valida interposicao recursal. Sustenta que, somados, os pedidos recursais poderiam elevar sua nota de 4,60 para patamar superior ao minimo exigido para aprovacao, circunstancia que evidencia o prejuizo material decorrente da ausencia de apreciacao administrativa. Foi proferida decisao (ID n. 2251708542) determinando ao impetrante que emendasse a inicial a fim de indicar a autoridade coatora vinculada a Fundacao Getulio Vargas. A parte impetrante apresentou emenda a inicial (ID n. 2251889661) pleiteando a inclusao do Diretor da Fundacao Getulio Vargas no polo passivo. E o relato. Decido. Para a concessao da medida liminar em mandado de seguranca a lei exige a presenca simultanea de dois requisitos: a presenca de fundamento relevante para o pedido e o risco de ineficacia da medida judicial, caso concedida somente ao final. A parte impetrante objetiva, em sintese, que seja determinada a analise e julgamento dos recursos administrativos por ele interpostos na segunda fase do 45º Exame de Ordem Unificado ou, subsidiariamente, a reabertura do prazo recursal para nova interposicao de recursos. Para fundamentar a sua pretensao, argumenta, em sintese, que houve falha sistemica no ambiente eletronico da banca examinadora, a qual teria impedido o processamento regular de seus recursos, sustentando que cumpriu as exigencias editalicias e que os protocolos gerados comprovam a valida interposicao, nao podendo a Administracao desconsidera-los com base em orientacao que reputa nao obrigatoria. No contexto de certames publicos e exames de proficiencia, como e o caso do 45º Exame de Ordem Unificado, o controle jurisdicional deve se pautar, primordialmente, pela verificacao da legalidade do procedimento e pela observancia das regras contidas no respectivo instrumento convocatorio. O edital impoe vinculacao estrita tanto a Administracao quanto aos candidatos, os quais devem observar integralmente as regras previamente estabelecidas. Nesse contexto, eventual flexibilizacao das normas editalicias somente se justifica diante de manifesta ilegalidade. Nesse sentido, tambem se evidencia o dever de diligencia e acompanhamento continuo dos atos do certame. O item 6.2 do edital (ID n. 2248827972, p. 28) atribui ao candidato a responsabilidade exclusiva de acompanhar todos os editais, comunicados e demais publicacoes oficiais. Trata-se de encargo inerente a participacao em processos seletivos dessa natureza, nao sendo possivel imputar a Administracao as consequencias da inobservancia desse dever. No caso concreto, verifica-se que a propria banca examinadora reconheceu a ocorrencia de instabilidade no sistema eletronico e, em observancia aos principios da autotutela administrativa e da razoabilidade, adotou providencias para sanar o vicio, mediante a restituicao integral do prazo recursal (de 21/03 a 24/03) e a divulgacao de comunicado com instrucoes especificas para nova interposicao dos recursos. Tais comunicados assumem carater vinculante no contexto do certame, na medida em que visam regular a forma adequada de superacao da falha tecnica reconhecida. Ademais, nao procede a alegacao de que tais instrucoes constituiriam mera sugestao. O termo  orientacao , no contexto do comunicado de ID n. 2248828436, deve ser interpretado a luz do dever de cooperacao e diligencia do candidato, assumindo carater diretivo e obrigatorio para a regularizacao da situacao excepcional criada pela falha sistemica. Ao deixar de seguir as instrucoes expressamente divulgadas pela banca, o impetrante assumiu o risco de nao processamento de seus recursos. Dessa forma, nao se verifica ilegalidade no ato administrativo que desconsiderou protocolos gerados em sistema reconhecidamente instavel, quando oportunizada, de forma clara e tempestiva, a regularizacao mediante novo envio. A previsibilidade de falhas tecnologicas, aliada a disponibilizacao de solucao pela banca organizadora, impoe ao candidato o dever de agir com cautela e diligencia reforcadas. Para alem disso, a pretensao deduzida pelo impetrante, se acolhida, implicaria violacao ao principio da isonomia, na medida em que beneficiaria candidato que deixou de observar as orientacoes oficiais, em detrimento daqueles que, diante da mesma situacao, diligenciaram e procederam a nova interposicao de seus recursos dentro do prazo restituido. Tal cenario comprometeria a igualdade de condicoes entre os participantes do certame. Assim, nao se verifica a existencia de fundamento relevante para o deferimento do pedido, tendo em vista que a banca examinadora atuou em conformidade com as regras editalicias, tendo reconhecido a falha sistemica, adotado medidas adequadas para sua correcao e oportunizado, de forma clara e isonomica, a regularizacao da situacao por todos os candidatos, nao sendo possivel imputar ilegalidade a conduta administrativa nem afastar as consequencias decorrentes da inobservancia, pelo impetrante, do dever de diligencia que lhe competia. Diante do exposto, INDEFIRO o pedido liminar requerido. Retifique-se a autuacao a fim de incluir o Diretor da FGV no polo passivo do feito. Notifique-se a autoridade coatora para que preste as informacoes necessarias no prazo de 10 (dez) dias. Intime-se o orgao de representacao judicial da autoridade, na forma do artigo 7º, inciso II, da Lei nº 12.016/2009. Apos o prazo legal de manifestacao da autoridade, manifeste-se o Ministerio Publico Federal, em 10 (dez) dias. Intimem-se. Rio Branco/AC, data da assinatura eletronica. Juiz Federal Documento assinado eletronicamente ||| POLO ATIVO: CAIQUE RAMOS CANEDO ADVOGADO: JANDERSON SOARES DA SILVA - OAB: 006345/AC Acesso ao documento: https://pje1g.trf1.jus.br:443/pje/Processo/ConsultaDocumento/listView.seam?x=26042712030173600002168237325 Identificador do documento: 595088359      NaN
1  9181530212  1006613-64.2026.4.01.3000         2026-04-29      FUNDACAO GETULIO VARGAS  DJEN - Diário de Justiça Eletrônico Nacional - JFED-AC  5696786   1ª Vara Federal Cível e Criminal da SJAC                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    Intimação    PROCESSO: 1006613-64.2026.4.01.3000 - MANDADO DE SEGURANcA CiVEL - || PODER JUDICIARIO JUSTICA FEDERAL Secao Judiciaria do Acre 1ª Vara Federal Civel e Criminal da SJAC SENTENCA TIPO  A  PROCESSO: 1006613-64.2026.4.01.3000 CLASSE: MANDADO DE SEGURANCA CIVEL (120) POLO ATIVO: DEBORA MELO SIMOES REPRESENTANTES POLO ATIVO: JOAO VICTOR BRANDAO REIS - AC7012 POLO PASSIVO: Ordem dos Advogados do Brasil Seccional Acre e outros SENTENCA Trata-se de mandado de seguranca impetrado por DEBORA MELO SIMOES em face do PRESIDENTE DO CONSELHO FEDERAL DA ORDEM DOS ADVOGADOS DO BRASIL, e da FUNDACAO GETULIO VARGAS (FGV), postulando a concessao de liminar que determine a reavaliacao das respostas as questoes 1-B, 3-B e 4-A de sua prova pratico-profissional de Direito Constitucional, atribuindo-se a pontuacao devida conforme o espelho de correcao, com a consequente expedicao e liberacao do certificado de aprovacao. Alega, em sintese, que se inscreveu para o 45º Exame de Ordem Unificado, optando pela Disciplina Direito Constitucional, tendo obtido 4,65 pontos na prova pratico-profissional, postulando a concessao de liminar que atribua 1,35 pontos ilegalmente suprimidos que alterariam sua nota final para 6 pontos e a colocaria na condicao de aprovada referido certame. Assere que lhe foi atribuida nota 0,00 nos tres itens citados, sendo que em cada um deles a candidata apresentou fundamentacao juridica pertinente e alinhada ao nucleo do conhecimento exigido, tendo inclusive acertado o posicionamento (positivo ou negativo) solicitado pelo enunciado Juntou documentos e requereu o beneficio da assistencia judiciaria gratuita. E o relatorio. Decido. Para a concessao da medida liminar em mandado de seguranca a lei exige a presenca simultanea de dois requisitos: a presenca de fundamento relevante para o pedido e o risco de ineficacia da medida judicial, caso concedida somente ao final. Pretende a parte autora a revisao dos criterios utilizados pela Banca Examinadora na correcao da sua prova pratico-profissional de Direito Constitucional do 45º Exame de Ordem Unificado da Ordem dos Advogados do Brasil - OAB. A materia aqui discutida nao apresenta maiores digressoes, ate mesmo porque analisando detidamente as alegacoes da parte autora ve-se que ela questiona o proprio acerto/desacerto dos criterios utilizados pela banca examinadora para corrigir a prova pratico profissional relacionada a area de Direito Constitucional. Em que pesem os argumentos levantados o que, de fato, se postula na presente demanda e uma revisao judicial acerca da correcao feita pela Banca do certame que diverge das escolhas feitas pelo impetrante. O impetrante recorreu da nota que foi atribuida a sua prova, justificando que as questoes 1-B, 3-B e 4-A foram corrigidas de forma ilegal pela Banca Examinadora, que nao lhe atribuiu os pontos devidos, causando-lhe sua reprovacao. Nao aponta erros materiais evidentes e de facil percepcao nem muito menos possiveis incongruencias perceptiveis primo ictu oculi entre as questoes e a matriz curricular prevista no edital. Em verdade, visa que este juizo faca prevalecer seu entendimento em substituicao ao entendimento da Banca Examinadora, o que contraria, claramente, acordao vinculante do STF sobre tal materia. O Supremo Tribunal Federal, por ocasiao do julgamento do Recurso Extraordinario 632.853, na sessao plenaria do dia 23.04.2015, sob o regime de repercussao geral (Tema 485), consolidou sua jurisprudencia pacifica no sentido de que nao compete ao Poder Judiciario substituir banca examinadora de concurso publico para reavaliar as respostas dadas pelos candidatos e as respectivas notas a eles atribuidas. O acordao restou ementado da seguinte forma: Recurso extraordinario com repercussao geral. 2. Concurso publico. Correcao de prova. Nao compete ao Poder Judiciario, no controle de legalidade, substituir banca examinadora para avaliar respostas dadas pelos candidatos e notas a elas atribuidas. Precedentes. 3. Excepcionalmente, e permitido ao Judiciario juizo de compatibilidade do conteudo das questoes do concurso com o previsto no edital do certame. Precedentes. 4. Recurso extraordinario provido. A anulacao de questao de prova pelo Poder Judiciario somente tem lugar na hipotese de flagrante ilegalidade na sua elaboracao, por parte da banca examinadora, sem o respeito as normas veiculadas no edital, nao sendo essa a hipotese que se examina. A jurisprudencia patria tem manifestado reiterado entendimento de que o Poder Judiciario e incompetente para, substituindo-se a banca examinadora de concurso publico, reexaminar o conteudo das questoes formuladas e os criterios de correcao das provas. Claramente, a eventual atribuicao de pontuacao a impetrante, enseja o exame e consideracoes sobre possiveis interpretacoes que o enunciado comportaria, extrapolando o limite do controle da legalidade e reexaminando os criterios de correcao, o que incumbe unicamente a banca examinadora. O caso, portanto, se amolda, a rigor, na hipotese prevista no artigo 332, II, do CPC, cujo teor e o seguinte: Art. 332. Nas causas que dispensem a fase instrutoria, o juiz, independentemente da citacao do reu, julgara liminarmente improcedente o pedido que contrariar: (...) II - acordao proferido pelo Supremo Tribunal Federal ou pelo Superior Tribunal de Justica em julgamento de recursos repetitivos, Considerando que o pedido contraria clara e inequivocamente a tese fixada pelo STF no julgamento do RE 632.853, nao resta alternativa a este juizo senao, adota-la como razao de decidir, para rejeita-lo liminarmente. Ante o exposto, JULGO LIMINARMENTE IMPROCEDENTE O PEDIDO com fundamento no artigo 332, II, do Codigo de Processo Civil. Defiro a assistencia judiciaria gratuita. Sem custas e sem honorarios advocaticios. Havendo recurso de apelacao, cite-se a parte recorrida para contrarrazoes. Apresentadas preliminares nas contrarrazoes, vista ao apelante. Tudo cumprido, remetam-se ao TRF(art. 1.010 ,§§ 1º ao 3º, do CPC). Transitada em julgado, arquivem-se os autos, com baixa na distribuicao. Intime-se a parte autora. Arquive-se, oportunamente. ||| POLO ATIVO: DEBORA MELO SIMOES ADVOGADO: JOAO VICTOR BRANDAO REIS - OAB: 007012/AC Acesso ao documento: https://pje1g.trf1.jus.br:443/pje/Processo/ConsultaDocumento/listView.seam?x=26042712174031800002168243792 Identificador do documento: 595696786      NaN
2  9181449363  1011963-67.2025.4.01.3000         2026-04-29  FUNDACAO GETULIO VARGAS FGV  DJEN - Diário de Justiça Eletrônico Nacional - JFED-AC  5406739   2ª Vara Federal Cível e Criminal da SJAC  Intimação    PROCESSO: 1011963-67.2025.4.01.3000 - MANDADO DE SEGURANcA CiVEL - || PODER JUDICIARIO TRIBUNAL REGIONAL FEDERAL DA PRIMEIRA REGIAO SECAO JUDICIARIA DO ESTADO DO ACRE 2ª VARA FEDERAL CIVEL E CRIMINAL DA SJAC SENTENCA TIPO  A  PROCESSO: 1011963-67.2025.4.01.3000 CLASSE: MANDADO DE SEGURANCA CIVEL (120) IMPETRANTE: FRANCISCO ALVES DE SOUZA NETO LITISCONSORTE: ORDEM DOS ADVOGADOS DO BRASIL CONSELHO FEDERAL, ORDEM DOS ADVOGADOS DO BRASIL SECCIONAL ACRE, FUNDACAO GETULIO VARGAS IMPETRADO: PRESIDENTE DA FUNDACAO GETULIO VARGAS - FGV, PRESIDENTE NACIONAL DA ORDEM DOS ADVOGADOS DO BRASIL - OAB SENTENCA FRANCISCO ALVES DE SOUZA NETO impetrou mandado de seguranca em face de ato atribuido ao PRESIDENTE NACIONAL DA ORDEM DOS ADVOGADOS DO BRASIL - OAB e ao PRESIDENTE DA FUNDACAO GETULIO VARGAS - FGV objetivando, liminarmente: a) a revisao da correcao de sua prova pratico-profissional do 43º Exame de Ordem Unificado, com a consequente atribuicao dos pontos que alega terem sido indevidamente suprimidos, e b) a declaracao de sua aprovacao no certame e expedicao do certificado de habilitacao para o exercicio da advocacia. No merito, requer a confirmacao do pedido liminar. Narra que se submeteu ao referido exame pratico-profissional na area de Direito do Trabalho e, apos a divulgacao do resultado preliminar, obteve a nota final de 5,65 (cinco e sessenta e cinco) pontos, sendo considerado reprovado, uma vez que a nota minima para aprovacao e de 6,00 (seis) pontos. Relata que a correcao de sua prova contem flagrantes erros materiais, que consistiram na nao atribuicao de pontuacao a respostas que estariam em estrita conformidade com o proprio gabarito definitivo divulgado pela banca examinadora. Aponta, de forma detalhada e especifica, cinco equivocos na avaliacao, os quais, se sanados, resultariam na majoracao de sua nota para 6,75 (seis e setenta e cinco) pontos, superando o patamar necessario para a aprovacao. Impugna, especificamente, os seguintes quesitos da sua peca pratico-profissional: a) nao pontuacao do Item 04, referente ao pedido de nulidade da citacao (0,70 pontos), b) nao pontuacao pela mencao expressa ao artigo 833, § 2º, do Codigo de Processo Civil, no Item 06 (0,10 pontos), c) nao pontuacao pela indicacao do artigo 224, § 2º, da Consolidacao das Leis do Trabalho (0,10 pontos), d) nao pontuacao pela mencao ao artigo 543, § 3º, da CLT (0,10 pontos), e e) nao pontuacao pela indicacao do artigo 462, § 1º, da CLT (0,10 pontos). Juntou documentos. Foi proferida decisao (ID 2214401419) deferindo o beneficio da justica gratuita contudo indeferindo o pedido liminar. As Autoridades Coatoras apresentaram informacoes (IDs 2215035226, 2222322501). O Ministerio Publico Federal entendeu ser desnecessario intervir no feito (ID 2232741761). E o relatorio. Decido. Seguem os fundamentos da decisao que indeferiu o pedido liminar (ID 2214401419):  Confira-se a seguir a resposta exigida pelo espelho de correcao, a resposta dada pelo candidato e a pontuacao atribuida para cada um dos pontos impugnados: Peca Pratico-Profissional, Item 4. Nulidade da Citacao (0,00/0,70/0,80 pontos) - ID n. 2205293425, p. 21 Resposta exigida: Requerer a nulidade de todo o processo porque nula/inexistente a citacao (0,70). Indicacao Art. 803, inciso II ou Art. 239 ou Art. 280, todos do CPC (0,10) Resposta do impetrante: (…) Diante do exposto, requer que seja declarada a nulidade da citacao, e a extincao da execucao. (ID n. 2205293425, p. 32). Recurso interposto: Na peca, constou:  Diante da inexistencia de citacao valida da Executada, requer-se a decretacao da nulidade da citacao e a extincao dos atos processuais subsequentes . Essa redacao contempla exatamente o nucleo padrao - nulidade de todo o processo por ausencia/inexistencia de citacao, fundamentada na legislacao processual aplicavel. (ID n. 2212799645, p. 2/3). Resposta ao recurso interposto: Recurso identificado: Francisco Alves de Souza Neto. Inscricao: 823033651 O Edital do Exame veda peremptoriamente a identificacao do examinando, justamente para manter incolume a impessoalidade e a transparencia. Assim, conforme termos do edital, a identificacao ocorrida neste caso impede a analise dos motivos apresentados. (ID n. 2212799645, p. 3) Da analise do item impugnado, verifica-se que, ao interpor o recurso administrativo, o candidato se identificou expressamente (nome e numero de inscricao constam do proprio recurso). Como ressaltado pela banca examinadora, o edital veda peremptoriamente qualquer identificacao do examinando, justamente para resguardar impessoalidade e isonomia. A banca, coerente com a clausula editalicia, nao conheceu do merito do recurso. Note-se que nao se trata de capricho burocratico, mas sim de regra de integridade do certame. Ainda que o conteudo da resposta do impetrante dialogue com o espelho, o candidato violou regra editalicia nuclear ao se identificar no recurso. Atribuir pontuacao por via judicial, a revelia da vedacao editalicia, convalidaria o vicio decorrente da propria conduta do candidato e comprometeria a isonomia entre os demais examinandos que observaram as regras do certame. O controle judicial nao se presta a sanar irregularidades autoinfligidas, tampouco a substituir criterios de impessoalidade por solucoes casuisticas. A intervencao jurisdicional nao pode desfigurar a impessoalidade, premissa basilar de concursos publicos. Portanto, a analise do item mostra-se prejudicada. Passo a analise do item 06. Peca Pratico-Profissional, Item 06. (...) Indicacao do Art. 529, §3°, ou Art. 833, §2°, ambos do CPC (0,00/0,70/0,80 pontos) - ID n. 2205293425, p. 21 Resposta exigida: Beneficio Previdenciario 6. Requerer a liberacao total da aposentadoria pela sua natureza alimentar/impenhorabilidade (0,70). Indicacao Art. 833, inciso IV, do CPC (0,10). ou Requerer a liberacao parcial da aposentadoria porque excedeu o limite legal (0,70). Indicacao do Art. 529, § 3º, ou Art. 833, § 2º, ambos do CPC (0,10). Resposta do impetrante: (…) Nos termos do art. 822, §2° do CPC, sao impenhoraveis (...) (ID n. 2205293425, p. 32, linha 81). Recurso interposto: Na peca constou a mencao ao artigo 833, §2° do CPC na linha 81 que diz:   nos termos do art. 833 §2° do CPC, sao impenhoraveis as prestacoes de carater alimentar . Portanto solicito a pontuacao de 0,10 pois foi mencionado correto o artigo. Resposta ao recurso interposto: Recurso identificado: Francisco Alves de Souza Neto. Inscricao: 823033651 O Edital do Exame veda peremptoriamente a identificacao do examinando, justamente para manter incolume a impessoalidade e a transparencia. Assim, conforme termos do edital, a identificacao ocorrida neste caso impede a analise dos motivos apresentados. (ID n. 2212799645, p. 3) Assim, como no item anterior, verifica-se que o candidato novamente se identificou no recurso interposto, razao pela qual a analise dos fundamentos apresentados, mais uma vez, mostra-se prejudicada, conforme fundamentos destacados no item anterior. Passo a analise do ponto item seguinte (questao 1). Questao 1 (ID n. 2205293425, p. 11). Jorge e Sonia sao casados, trabalhavam no banco Dinheiro Vivo S.A., e foram dispensados sem justa causa em novembro de 2023. Nos ultimos cinco anos, Jorge ocupava o cargo de gerente de agencia, com carteira de clientes, assinatura autorizada e tinha dois assistentes que o auxiliavam quando necessario. Sonia era a gerente-geral da agencia nos ultimos sete anos, estando hierarquicamente acima dos demais gerentes, de modo que controlava a produtividade deles, participava do comite de credito e reportava o que de relevante havia a direcao do banco. Ambos recebiam salario e gratificacao de funcao de 100%. Apos a dispensa, o casal ajuizou uma reclamacao trabalhista plurima requerendo o pagamento de horas extras e reflexos. Jorge disse que apesar de o bancario ter jornada de seis horas diarias, conforme o Art. 224, caput, da CLT, ele se ativava das 9 as 18 horas, com intervalo de 1 (uma) hora para a refeicao. Ja Sonia disse que trabalhava das 8 as 20 horas, com pausa alimentar de uma hora. Considerando a situacao narrada, os termos da CLT e o entendimento consolidado do TST, responda as indagacoes a seguir, ciente de que voce e o(a) advogado(a) do banco. A) Que tese juridica voce sustentaria na contestacao contra o pedido de horas extras formulada por Jorge? Justifique. (Valor 0,65) B) Que tese juridica voce advogaria na contestacao contra o pedido de horas extras formulada por Sonia? Justifique. (Valor 0,60) Resposta exigida: A. Jorge esta vinculado a uma jornada de oito horas diarias (0,55). Art. 224, §2°, da CLT, ou Sumula 102, incisos II ou IV, do TST (0,10). (0,00/0,55/0,65 pontos) - ID n. 2205293425, p. 21 Resposta do impetrante: A) A Tese juridica a ser sustentada e a de que Jorge por ser gerente de agencia e receber gratificacao de 100% pela funcao, nao se enquadra no art. 224, §2° da CLT, pois exerce funcao de gerencia, desta forma nao lhe cabe o recebimento de horas extras, nos termos da Sumula 102 do TST (ID n. 2205293425, p. 23). Recurso interposto: Preliminarmente, requer-se a atribuicao da pontuacao integral aos itens A e B da resposta ao candidato, tendo em vista que as teses juridicas apresentadas estao em conformidade com a legislacao trabalhista e com a jurisprudencia consolidada do TST, ainda que com terminologia distinta da utilizada pela banca. (…) (ID n. 2212799645, p. 4/5) Resposta ao recurso interposto: a) Muito embora seja correto afirmar que Jorge exerce cargo de confianca bancaria na forma art. 224 §2°, da CLT, de tal circunstancia nao se pode inferir que ele nao tem direito a horas extras. Isso porque a norma trabalhista, em realidade, preve que o bancario enquadrado no referido dispositivo legal vincula-se a jornada de oito horas diarias e por certo que o trabalho alem desse modulo diario implica necessariamente em horas extras. Ante o exposto, forcoso concluir que a resposta nao pode ser validada porque encerra fundamentacao em desconformidade com a norma de regencia e ainda porque o examinando nao soube extrair dos fatos narrados uma adequada qualificacao juridica. Nota mantida. b) Prospera em parte o inconformismo, pois a resposta do candidato esta conforme o gabarito, exceto quanto ao fundamento legal/jurisprudencial, de modo que a nota e alterada para 0,50. (ID n. 2212799645, p. 5/6) No que se refere a questao 1, item A, o espelho de correcao exigia o enquadramento do bancario na jornada de oito horas diarias, nos termos do art. 224, § 2º, da CLT, ou da Sumula 102 do TST, admitindo-se o pagamento de horas extras apenas quanto ao labor excedente. O impetrante, contudo, sustentou tese no sentido de que Jorge nao faria jus a horas extras em razao da gratificacao de funcao e do enquadramento no art. 224, § 2º, da CLT, conclusao que destoa da norma e da jurisprudencia consolidada. Nao se trata, portanto, de erro material, mas de divergencia interpretativa quanto a aplicacao da lei, hipotese em que nao cabe ao Poder Judiciario substituir a banca examinadora. Assim, nao assiste razao ao impetrante quanto a esse ponto. Passo a analise do item seguinte (questao 3). Questao 3 (ID n. 2205293425, p. 14) Sonia, empregada de uma sociedade empresaria, foi eleita dirigente sindical e empossada em janeiro de 2023 para um mandato de dois anos. Em julho de 2024, a sociedade empresaria acusou Sonia de estimular os empregados a realizar uma especie de motim. Sonia teria combinado com varios empregados a ausencia coletiva em determinado dia, para prejudicar financeiramente a sociedade empresaria e forca-la a aceitar novos beneficios para os empregados. Por conta disso, o empregador imediatamente dispensou Sonia por justa causa, afirmando possuir provas robustas de todo o alegado. A ex-empregada o(a) procurou, como advogado(a), para resolver a situacao. A) A forma pela qual a sociedade empresaria realizou a dispensa por justa causa foi adequada? Justifique. (Valor: 0,65) Resposta exigida: A. Nao, porque deveria ajuizar inquerito/inquerito judicial/inquerito para a apuracao de falta grave (0,55). Art. 543, § 3º, da CLT, ou Sumula 197 STF ou Sumula 379 TST (0,10). (0,00/0,55/0,65 pontos) - ID n. 2205293425, p. 22 Resposta do impetrante: A forma de dispensa foi indevida, pois Sonia por ter sido eleita dirigente sindical, conta com estabilidade ate 1 ano apos o final do seu mandato, o mandato termina em janeiro de 2025 e sua estabilidade se daria ate janeiro de 2026, conforme art. 543 § 3º da CLT. (ID n. 2205293425, p. 24). Recurso interposto: Preliminarmente, requer-se a atribuicao da pontuacao integral ao item A da resposta do candidato, tendo em vista que a fundamentacao apresentada esta em conformidade com a legislacao vigente e nao diverge do entendimento consolidado pela jurisprudencia (…) (ID n. 2212799645, p. 6/7) Resposta ao recurso interposto: a) O que se buscava medir na questao era se a dispensa por justa causa aplicada de plano pelo empregador foi adequada, impondo-se resposta negativa porque esse ato juridico deveria, obrigatoriamente, ser antecedido de uma acao (inquerito/inquerito judicial/inquerito para a apuracao de falta grave). Isso nao foi atendido pelo candidato, pelo que a nota deve ser mantida. (ID n. 2212799645, p. 8) No tocante a questao 3, item A, o espelho de correcao estabelecia como resposta adequada a negativa da dispensa por justa causa, em razao da necessidade de previo inquerito judicial para apuracao de falta grave, com fundamento no art. 543, § 3º, da CLT, ou em sumulas correlatas do STF e TST. O impetrante, entretanto, limitou-se a sustentar que Sonia, na qualidade de dirigente sindical, possuia estabilidade provisoria ate um ano apos o termino do mandato, citando expressamente o art. 543, § 3º, da CLT. Ainda que o dispositivo legal tenha sido corretamente mencionado, a resposta nao enfrentou o nucleo da questao proposta, que residia na obrigatoriedade de instauracao de inquerito judicial previo. Assim, constata-se que nao houve erro na correcao, mas inadequacao da resposta ao comando da questao. Nao ha, portanto, espaco para intervencao jurisdicional nesse ponto. Passo a analise do ultimo item (questao 4). Questao 4 (ID n. 2205293425, p. 16) Maria trabalhou em uma sociedade empresaria de 2015 a 2024, quando foi dispensada sem justa causa, ocasiao em que recebia o salario fixo de R$ 3.000,00 (tres mil reais) mensais. A sociedade empresaria marcou uma data para o pagamento das verbas devidas, no prazo fixado na CLT. Ao comparecer para o recebimento, Maria verificou que no seu Termo de Rescisao doContrato de Trabalho (TRCT) havia um desconto de R$ 2.500,00 (dois mil e quinhentos reais), justificado como  prejuizo a empresa . Maria questionou a situacao e foi informada que a subtracao era pela compensacao de uma maquina que, por distracao, foi inutilizada por Maria, sendo que havia a previsao em seu contrato de trabalho de descontos por prejuizos causados pela empregada. Foi ainda apresentada a nota fiscal de compra de uma nova maquina tal qual a avariada. Maria recordava-se de que, de fato, havia quebrado um equipamento da sociedade empresaria por descuido. Considerando o caso narrado e a legislacao de regencia, responda as indagacoes a seguir. A) O desconto efetuado pela sociedade empresaria no TRCT e valido? Justifique. (Valor: 0,65) Resposta exigida: A. Sim, porque esta previsto no contrato e houve culpa (0,55). Art. 462, §1°, CLT (0,10). (0,00/0,55/0,65 pontos) - ID n. 2205293425, p. 22 Resposta do impetrante: o desconto nao e valido, tendo em vista que maria nao teve dolo em quebrar o equipamento, o desconto so seria valido se maria autorizasse o desconto, conforme o artigo 462 § 1º da CLT (ID n. 2205293425, p. 25). Recurso interposto: Preliminarmente, requer-se a atribuicao de pontuacao integral a resposta apresentada pelo candidato, tendo em vista que a fundamentacao juridica esta em conformidade com a legislacao vigente e coma jurisprudencia consolidada (...) (ID n. 2205293425, p. 8) Resposta ao recurso interposto: a) Trata-se de resposta diametralmente oposta a constante no gabarito e advogando tese que nao se ancora no art. 462, §1°, da CLT. De acordo com esse dispositivo legal, a possibilidade de desconto em razao de dano causado pelo empregado nao deriva exclusivamente da conduta dolosa, sendo certo que no caso concreto houve culpa de Maria e previsao contratual para desconto. Nota mantida. (ID n. 2212799645, p. 10) No que se refere a questao 4, item A, o espelho de correcao fixou como resposta adequada a validade do desconto diante da culpa da empregada e da previa previsao contratual, com referencia ao art. 462, § 1º, da CLT. O impetrante defendeu a invalidade do desconto por ausencia de dolo e por suposta necessidade de autorizacao expressa, tese que contraria o nucleo exigido: o dispositivo legal admite o desconto quando houver culpa do empregado e ajuste contratual, prescindindo de autorizacao especifica nessa hipotese. Logo, nao ha erro a ser corrigido, mas inadequacao da resposta ao comando da questao. Portanto, mantem-se a nota atribuida pela banca quanto a este item. Diante do exposto, INDEFIRO o pedido liminar requerido.  No caso em exame, nao se verifica qualquer alteracao no quadro fatico anteriormente delineado. O impetrante pretende o reexame de avaliacao de natureza eminentemente subjetiva realizada pela banca examinadora. No tocante aos itens impugnados na via administrativa, verifica-se que as razoes recursais nao evidenciam erro material grosseiro, limitando-se a demonstrar divergencia entre a resposta apresentada pelo candidato e o padrao tecnico-juridico fixado no espelho de correcao. Ademais, quanto a peca pratico-profissional, constata-se que o impetrante violou regra editalicia essencial relativa ao anonimato, ao inserir identificacao no corpo do recurso, circunstancia que, nos termos do edital, obsta o conhecimento do merito pela banca examinadora. Nesse contexto, a intervencao do Poder Judiciario para promover a majoracao de notas, em descompasso com os criterios tecnicos adotados pela banca e com as normas do certame, implicaria indevida ingerencia na esfera administrativa, em afronta ao principio da separacao de poderes, alem de comprometer a isonomia entre os candidatos submetidos as mesmas regras e condicoes de avaliacao. Diante disso, impoe-se a denegacao da seguranca. Ante o exposto, DENEGO a seguranca pleiteada por FRANCISCO ALVES DE SOUZA NETO, fazendo-o com resolucao do merito, na forma do art. 487, I do CPC. Custas pela parte impetrante cuja exigibilidade ficara suspensa em face do deferimento da assistencia judiciaria gratuita. Sem condenacao em honorarios (art. 25 da Lei 12.016/09). Havendo recurso, intime-se a parte contraria para que apresente contrarrazoes. Sentenca nao sujeita ao reexame necessario. Apos o transito em julgado, arquivem-se os autos. Intimem-se. Rio Branco-AC, data da assinatura eletronica. THIAGO MILHOMEM DE SOUZA BATISTA Juiz Federal Documento assinado eletronicamente ||| POLO ATIVO: FRANCISCO ALVES DE SOUZA NETO POLO PASSIVO: ORDEM DOS ADVOGADOS DO BRASIL CONSELHO FEDERAL POLO PASSIVO: ORDEM DOS ADVOGADOS DO BRASIL SECCIONAL ACRE ADVOGADO: ALFREDO SEVERINO JARES DAOU - OAB: 003446/AC Acesso ao documento: https://pje1g.trf1.jus.br:443/pje/Processo/ConsultaDocumento/listView.seam?x=26041511560293500002166051783 Identificador do documento: 595406739      NaN
